meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{host_gateway}}/api/v1/oauth/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: backend-service
  password: secret
}

body:form-urlencoded {
  username: jose
  password: 1234
  grant_type: password
}

tests {
  test("should return success", function () {
    var body = res.body;
    expect(res.getStatus()).to.equal(200);
    // Save token to environment variable
    bru.setVar("authToken", body.access_token);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
