meta {
  name: Consultar Propopostas
  type: http
  seq: 8
}

get {
  url: {{host_gateway}}/api/trade/all?expiradas=true
  body: none
  auth: bearer
}

params:query {
  expiradas: true
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
  
    "customer": "América Minerio",
    
    "priceTonne":135.0,
    
    "tonnes" : 100,
    
    "country":"JPN",
    
    "proposalValidDays": 5
    
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
