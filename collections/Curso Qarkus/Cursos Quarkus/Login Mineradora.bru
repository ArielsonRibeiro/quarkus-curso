meta {
  name: Login Mineradora
  type: http
  seq: 2
}

post {
  url: http://localhost:8081/realms/quarkus/protocol/openid-connect/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: backend-service
  password: secret
}

body:form-urlencoded {
  username: china.miner
  password: 1234
  grant_type: password
}

tests {
  test("should return success", function () {
    var body = res.body;
    expect(res.getStatus()).to.equal(200);
    // Save token to environment variable
    bru.setVar("authTokenMiner", body.access_token);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
