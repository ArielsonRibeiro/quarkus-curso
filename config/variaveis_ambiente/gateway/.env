#https://quarkus.io/guides/config-reference#environment-variables

#QUARKUS_HTTP_PORT=8095

# Configuração da segurança com keycloak
QUARKUS_OIDC_AUTH-SERVER-URL=http://192.168.56.1:8081/realms/quarkus
QUARKUS_OIDC_CLIENT-ID=backend-service
QUARKUS_OIDC_CREDENTIALS_SECRET=secret

QUARKUS_OIDC-CLIENT_AUTH-SERVER-URL=${quarkus_oidc_auth-server-url}
QUARKUS_OIDC-CLIENT_CLIENT-ID=${quarkus_oidc_client-id}
QUARKUS_OIDC-CLIENT_CREDENTIALS_SECRET=${quarkus_oidc_credentials_secret}

#Rest client Configuration com quarkus-rest-client-oidc-token-propagation
ORG_BR_MINERADORA_GATEWAY_CLIENT_PROPOSALCLIENT/MP-REST/URL=http://br-mineradora-proposal:8080
ORG_BR_MINERADORA_GATEWAY_CLIENT_REPORTCLIENT/MP-REST/URL=http://br-mineradora-report:8080

# Rest client configuração
QUARKUS_REST-CLIENT__ORG_BR_MINERADORA_GATEWAY_CLIENT_OAUTHCLIENT__URL=http://192.168.56.1:8081

QUARKUS_LOG_CATEGORY__ORG_BR_MINERADORIA_GATEWAY_FILTER_LOGGINGFILTER__LEVEL=FINER

QUARKUS_LOG_CATEGORY__ORG_QUARKUS_OIDC__LEVEL=DEBUG


# Enable logging of request and response scope (line, headers, and body)
#QUARKUS_REST-CLIENT_LOGGING_SCOPE=request-response

# Truncate logged body after N characters (e_g_, 1024)
#QUARKUS_REST-CLIENT_LOGGING_BODY-LIMIT=1024

# Set the log level to DEBUG for the REST client logging category
#QUARKUS_LOG_CATEGORY__ORG_JBOSS_RESTEASY_REACTIVE_CLIENT_LOGGING__LEVEL=DEBUG


#https://pt_quarkus_io/guides/openapi-swaggerui
QUARKUS_SWAGGER-UI_ALWAYS-INCLUDE = true
QUARKUS_SMALLRYE-OPENAPI_INFO-DESCRIPTION = BR mineradora : Trade de Minerio

#https://quarkus_io/guides/opentelemetry
QUARKUS_OTEL_METRICS_ENABLED=true
QUARKUS_OTEL_LOGS_ENABLED=true
QUARKUS_APPLICATION_NAME=gateway-bff 
QUARKUS_OTEL_SERVICE_NAME=gateway-bff 
QUARKUS_OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.56.1:4317
#QUARKUS_OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer my_secret 
QUARKUS_LOG_CONSOLE_FORMAT=%d{HH:mm:ss} %-5p traceId=%X{traceId}, parentId=%X{parentId}, spanId=%X{spanId}, sampled=%X{sampled} [%c{2_}] (%t) %s%e%n

# Habilitar HTTPS
QUARKUS_HTTP_SSL_CERTIFICATE_KEY-STORE-FILE=/opt/variaveis/gateway/certificado.pfx
QUARKUS_HTTP_SSL_CERTIFICATE_KEY-STORE-PASSWORD=1234
QUARKUS_HTTP_SSL_CERTIFICATE_KEY-STORE-FILE-TYPE=PKCS12
QUARKUS_HTTP_SSL-PORT=8443
# (OPCIONAL) FORÇAR O USO DE SSL
# QUARKUS_HTTP_INSECURE-REQUESTS=redirect