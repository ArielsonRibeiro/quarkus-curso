{
  "openapi" : "3.1.0",
  "components" : {
    "schemas" : {
      "ProposalDetailsDTO" : {
        "type" : "object",
        "properties" : {
          "proposalId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "customer" : {
            "type" : "string"
          },
          "priceTonne" : {
            "type" : "number"
          },
          "tonnes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "country" : {
            "type" : "string"
          },
          "proposalValidDays" : {
            "type" : "string"
          }
        }
      },
      "PropostaNaoLocalizadaException" : {
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "SecurityScheme" : {
        "type" : "openIdConnect",
        "openIdConnectUrl" : "http://192.168.56.1:8081/realms/quarkus/.well-known/openid-configuration",
        "description" : "Authentication"
      }
    }
  },
  "paths" : {
